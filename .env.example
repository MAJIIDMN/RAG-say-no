# Copy to .env (`make setup` does it). Never commit .env.
# Only needed for configs that use `generator: {impl: llm}` or `judge: {impl: llm}`.

# Generator LLM.
#   openai_compatible: any OpenAI-style endpoint (OpenRouter, DeepSeek, Groq, Together,
#                      Gemini OpenAI-compat, Ollama, vLLM). Set LLM_BASE_URL accordingly.
#   anthropic:         native Anthropic API (LLM_BASE_URL is ignored).
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Structured output modes tried in order until one returns valid JSON.
LLM_STRUCTURED_MODES=json_schema,json_object,text
# USD per 1M tokens, used for $/query in eval reports.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# Judge LLM for eval. Empty values fall back to the LLM_* values above.
# Prefer a different model from the generator to reduce self-preference bias.
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Optional: authenticated Hugging Face downloads for embedding/reranker models.
HF_TOKEN=
